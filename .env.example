# =============================================================================
# OFFICINA MANAGER - ENVIRONMENT VARIABLES
# Copy this file to `.env` and fill in the real values.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET= # Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE (REQUIRED)
# -----------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
# For PostgreSQL: postgresql://user:password@localhost:5432/officina

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
TWO_FACTOR_ENCRYPTION_KEY= # Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# -----------------------------------------------------------------------------
# SEED ADMIN
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@azienda.it
SEED_ADMIN_PASSWORD= # Set a strong password

# -----------------------------------------------------------------------------
# SMS PROVIDERS (Optional - choose one or more)
# -----------------------------------------------------------------------------
# TWILIO
#TWILIO_ACCOUNT_SID=your-account-sid
#TWILIO_AUTH_TOKEN=your-auth-token
#TWILIO_FROM_NUMBER=+391234567890

# VONAGE
#VONAGE_API_KEY=your-api-key
#VONAGE_API_SECRET=your-api-secret
#VONAGE_FROM_NUMBER=VonagePhoneNumber

# -----------------------------------------------------------------------------
# COMPANY INFO (Optional - for documents and invoices)
# -----------------------------------------------------------------------------
COMPANY_NAME="Officina Manager"
COMPANY_ADDRESS="Via Example 123, Città"
COMPANY_PHONE="+391234567890"
COMPANY_EMAIL="info@officinamanager.it"
VAT_NUMBER="IT12345678901"
FISCAL_CODE="ABCDEF12G34H567I"

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Uncomment to restrict server actions to specific origins
# SERVER_ACTIONS_ALLOWED_ORIGINS=http://localhost:3000,https://yourapp.com

# === ACCESSO DEV (SOLO SVILUPPO) ===
# Abilita un pulsante "Accesso DEV" nel login che entra come seed admin senza password.
# Funziona SOLO se NODE_ENV!=production E ALLOW_DEV_LOGIN=true. Lascia false in produzione.
# ALLOW_DEV_LOGIN          -> cancello lato server (autorizza il bypass)
# NEXT_PUBLIC_ALLOW_DEV_LOGIN -> mostra/nasconde il pulsante nel form di login
ALLOW_DEV_LOGIN=false
NEXT_PUBLIC_ALLOW_DEV_LOGIN=false

# WhatsApp (Twilio) - numero mittente WhatsApp Business approvato, es. whatsapp:+39...
# In sviluppo lascia vuoto: si usa la sandbox Twilio whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# === AI SCAN LIBRETTO (Groq, gratis) - crea la chiave su https://console.groq.com ===
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Fuso orario applicazione
TZ=Europe/Rome
