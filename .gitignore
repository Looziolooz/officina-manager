# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# debug/fix scripts with hardcoded passwords
/*.mjs
# ...ma NON i file di config essenziali per la build (vengono comunque committati)
!postcss.config.mjs
!eslint.config.mjs
reset-admin.ts

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.vercel
.env*.local

# =============================================================================
# AI CODING AGENTS — block ALL state, settings, transcripts, logs
# =============================================================================

# --- Claude Code (Anthropic) ---
.claude/
.claude
.claude.json
.claude.json.backup
.claude.local.json
.claudeignore
.claude-code/
.claude_session
.claude_history
claude-*.log
claude-debug-*.log
CLAUDE.md
CLAUDE.local.md
**/.claude/
**/.claude.json
**/CLAUDE.local.md

# --- opencode (sst-dev) ---
.opencode/
.opencode
.opencode.json
.opencode.json.local
.opencodeignore
.opencode_session
.opencode_history
opencode-*.log
opencode-debug-*.log
AGENTS.md
AGENTS.local.md
**/.opencode/
**/.opencode.json
**/AGENTS.local.md

# --- generic agent / IDE-AI artefacts (precaution) ---
.cursor/
.aider*
.continue/
.codeium/
*.agent.log
.ai-cache/
.agents/

# database locale (SQLite) - non committare
*.db
*.db-journal
